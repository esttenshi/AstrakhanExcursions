@{
    ViewData["Title"] = "Register";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="login-container">
    <div class="login-form">
        <h2 class="text-center">Регистрация</h2>
        <form asp-controller="Account" asp-action="Register" method="post" id="registerForm">
            <div class="form-group">
                <label for="email">Логин</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="Введите email" required value="@ViewData["Email"]">
                <span asp-validation-for="email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="password">Пароль</label>
                <input type="password" class="form-control" id="password" name="password" placeholder="Введите пароль" required minlength="6">
            </div>
            <div class="form-group">
                <label for="confirmPassword">Подтверждение пароля</label>
                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Введите пароль ещё раз" required minlength="6">
            </div>
            <button type="submit" class="btn btn-primary">Зарегистрироваться</button>
        </form>
    </div>
    <style>
        .text-center {
            text-align: center;
        }

        .mb-4 {
            margin-bottom: 1.5rem;
        }
    </style>
</div>

<script>
    const passwordInput = document.getElementById('password');
    const confirmInput = document.getElementById('confirmPassword');
    const emailInput = document.getElementById('email');

    confirmInput.oninput = function (event) {
        event.target.setCustomValidity('');
    };

    confirmInput.oninvalid = function (event) {
        if (passwordInput.value !== confirmInput.value) {
            event.target.setCustomValidity('Пароли не совпадают');
        } else {
            event.target.setCustomValidity('');
        }
    };

    document.getElementById('registerForm').addEventListener('submit', function (event) {
        if (passwordInput.value !== confirmInput.value) {
            confirmInput.setCustomValidity('Пароли не совпадают');
            confirmInput.reportValidity();
            event.preventDefault();
        } else {
            confirmInput.setCustomValidity('');
        }
    });

    emailInput.addEventListener('input', function () {
        emailInput.setCustomValidity('');
    });

    passwordInput.addEventListener('input', function () {
        passwordInput.setCustomValidity('');
    });

</script>

@if (ViewData["Message"] != null && ViewData["Message"].ToString().Contains("Пользователь с таким email уже существует"))
{
    <script>
        emailInput.setCustomValidity('Пользователь с таким email уже существует');
        emailInput.reportValidity();
    </script>
}