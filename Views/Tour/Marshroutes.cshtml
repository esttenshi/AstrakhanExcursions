@{
    Layout = "_Layout";
    ViewData["Title"] = "Мои маршруты";
    var tours = ViewData["Tours"] as List<TourViewModel>;
}

<div class="container-fluid">
    <div class="col-md-6 scrollable-cards">
        <input type="text" id="searchInput" placeholder="Поиск по тегам, названию или описанию" onkeyup="searchTours()" class="form-control mb-3">
        <div class="row">
            <div class="col-md-12 card-column">
                @if (tours != null && tours.Any())
                {
                    @foreach (var tour in tours)
                    {
                        var tags = string.Join(" ", tour.Tags);
                        <div class="card tour-card"
                             data-title="@tour.Tour.Title.ToLower()"
                             data-description="@tour.Tour.Description.ToLower()"
                             data-tags="@tags.ToLower()"
                             data-id="@tour.Tour.TourId" onclick="selectTour(this)">
                            <div class="card-body">
                                <h5 class="card-title">@tour.Tour.Title</h5>
                                <p class="card-text">@tour.Tour.Description</p>
                                <ul>
                                    @foreach (var tag in tour.Tags)
                                    {
                                        <li>@tag</li>
                                    }
                                </ul>
                                <button class="btn btn-primary toggle-places" onclick="togglePlaces(event)">Показать места</button>
                                <div class="places" style="display: none;">
                                    <ul>
                                        @foreach (var place in tour.Places)
                                        {
                                            <li>@place</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p>Нет доступных маршрутов</p>
                }
            </div>
        </div>
    </div>
    <button id="routeButton" class="btn btn-success mt-3" onclick="checkGeolocation()" disabled>Проложить маршрут</button>
    <div class="col-md-6 map-column">
        <div id="map" style="height: 100%; width: 100%;"></div>
    </div>
</div>

<!-- Модальное окно для уведомлений -->
<div id="resultOperation" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeResultOperation()">&times;</span>
        <h2 id="resultOperationTitle"></h2>
    </div>
</div>

<script src="https://api-maps.yandex.ru/2.1/?lang=ru_RU&apikey=1e732a5d-da76-47ee-b449-0e7a5e8d4555" type="text/javascript"></script>
<script>
    let selectedTourId = null;
    let myMap;
    let searchControl;
    let selectedCard = null;
    let geolocationPermissionGranted = false;
    let startCoordinates = null;

    ymaps.ready(function () {
        myMap = new ymaps.Map('map', {
            center: [46.347616, 48.030175],
            zoom: 12,
            controls: ['searchControl']
        }, {
            searchControlProvider: 'yandex#search'
        });

        searchControl = myMap.controls.get('searchControl');

        // Запрос разрешения на геолокацию при загрузке страницы
        if (navigator.permissions) {
            navigator.permissions.query({ name: 'geolocation' }).then(function (permissionStatus) {
                if (permissionStatus.state === 'granted') {
                    geolocationPermissionGranted = true;
                } else {
                    permissionStatus.onchange = function () {
                        geolocationPermissionGranted = (permissionStatus.state === 'granted');
                    };
                }
            });
        }

        // Обработка выбора результата поиска
        searchControl.events.add('resultselect', function (e) {
            const selectedResult = searchControl.getResultsArray()[e.get('index')];
            startCoordinates = selectedResult.geometry.getCoordinates();
            showModalMessage("Начальная точка установлена. Нажмите 'Проложить маршрут' для построения маршрута.");
        });
    });

    function togglePlaces(event) {
        event.stopPropagation();
        const button = event.target;
        const places = button.nextElementSibling;
        places.style.display = places.style.display === "none" ? "block" : "none";
        button.textContent = places.style.display === "none" ? "Показать места" : "Скрыть места";
    }

    function searchTours() {
        const input = document.getElementById("searchInput").value.toLowerCase();
        document.querySelectorAll(".tour-card").forEach(card => {
            const title = card.getAttribute("data-title");
            const description = card.getAttribute("data-description");
            const tags = card.getAttribute("data-tags");
            card.style.display = title.includes(input) || description.includes(input) || tags.includes(input) ? "" : "none";
        });
    }

    function selectTour(card) {
        if (selectedCard === card) {
            // Если кликаем на уже выбранную карточку - снимаем выделение
            card.classList.remove('selected');
            selectedCard = null;
            selectedTourId = null;
            document.getElementById("routeButton").disabled = true;
            return;
        }

        // Снимаем выделение с предыдущей карточки
        if (selectedCard) {
            selectedCard.classList.remove('selected');
        }

        // Выделяем новую карточку
        card.classList.add('selected');
        selectedCard = card;
        selectedTourId = card.getAttribute("data-id");
        document.getElementById("routeButton").disabled = false;
    }

    function checkGeolocation() {
        if (!selectedTourId) {
            showModalMessage("Выберите маршрут для построения");
            return;
        }

        if (startCoordinates) {
            fetchAndBuildRoute(startCoordinates[0], startCoordinates[1]);
        } else if (geolocationPermissionGranted) {
            navigator.geolocation.getCurrentPosition(
                position => {
                    fetchAndBuildRoute(position.coords.latitude, position.coords.longitude);
                },
                error => {
                    showModalMessage("Ошибка при получении геопозиции: " + error.message);
                    searchControl.options.set('visible', true);
                    searchControl.search('');
                },
                { enableHighAccuracy: true }
            );
        } else {
            searchControl.options.set('visible', true);
            searchControl.search('');
            showModalMessage("Укажите начальную точку в поисковой строке на карте");
        }
    }

    function fetchAndBuildRoute(latitude, longitude) {
        fetch(`/api/Route/places/${selectedTourId}`)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Ошибка сети');
                }
                return response.json();
            })
            .then(places => {
                if (!places?.length) {
                    showModalMessage("Для выбранного тура нет мест");
                    return;
                }

                places.sort((a, b) =>
                    getDistance(latitude, longitude, a.latitude, a.longitude) -
                    getDistance(latitude, longitude, b.latitude, b.longitude)
                );

                buildRoute([
                    [latitude, longitude],
                    ...places.map(p => [p.latitude, p.longitude])
                ], places);
            })
          ;
    }

    function getDistance(lat1, lon1, lat2, lon2) {
        const R = 6371000;
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
            Math.sin(dLon / 2) * Math.sin(dLon / 2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function buildRoute(routePoints, places) {
        myMap.geoObjects.removeAll();

        const multiRoute = new ymaps.multiRouter.MultiRoute({
            referencePoints: routePoints
        }, { boundsAutoApply: true, wayPointVisible: false });

        myMap.geoObjects.add(multiRoute);

        places.forEach((place) => {
            const placemark = new ymaps.Placemark([place.latitude, place.longitude], {
                balloonContent: `<strong>${place.name}</strong><br>${place.description}`
            }, {
                preset: 'islands#circleIcon',
                iconColor: '#0095b6'
            });

            // Открываем балун при клике на метку
            placemark.events.add('click', function () {
                placemark.balloon.open();
            });

            myMap.geoObjects.add(placemark);
        });

        myMap.setBounds(multiRoute.getBounds(), { checkZoomRange: true });
    }

    function showModalMessage(message) {
        document.getElementById('resultOperationTitle').textContent = message;
        document.getElementById('resultOperation').style.display = 'block';
    }

    function closeResultOperation() {
        document.getElementById('resultOperation').style.display = 'none';
    }
</script>

<style>
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.5);
    }

    .modal-content {
        background-color: #fff;
        margin: 15% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
        max-width: 500px;
    }

    .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
    }
</style>
