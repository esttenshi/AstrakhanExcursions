@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
    var user = ViewData["User"] as AstrakhanExcursions.Models.User;
    ViewData["UserId"] = user.UserId;
}

<h2 class="text-center">Личный кабинет пользователя</h2>

<div class="container mt-4 d-flex justify-content-center">
    <div class="card" style="width: 100%; max-width: 600px;">
        <div class="card-body">
            <h5 class="card-title">Информация о пользователе</h5>
            <p class="card-text"><strong>Логин:</strong> @user.Email</p>
            <button class="btn btn-primary" onclick="openEditEmailModal()">Редактировать почту</button>
            <button class="btn btn-primary" onclick="openChangePasswordModal()">Изменить пароль</button>
        </div>
    </div>
</div>

<!-- Модальное окно результата операции -->
<div id="resultOperation" class="modal" style="display:none;">
    <div class="modal-content">
        <span class="close" onclick="closeResultOperation()">&times;</span>
        <h2 id="resultOperationTitle"></h2>
    </div>
</div>

<!-- Модальное окно для редактирования почты -->
<div id="editEmailModal" class="modal" style="display:none;">
    <div class="modal-content">
        <span class="close" onclick="closeEditEmailModal()">&times;</span>
        <h2>Редактировать почту</h2>
        <form action="EditEmail" method="post" id="editEmailForm" novalidate>
            <input type="hidden" name="userId" value="@user.UserId" />
            <div class="form-group">
                <label for="currentPassword">Текущий пароль:</label>
                <input type="password" class="form-control" id="currentPassword" name="currentPassword" placeholder="Введите пароль" required>
            </div>
            <div class="form-group">
                <label for="newEmail">Новая почта:</label>
                <input type="email" class="form-control" id="newEmail" name="newEmail" placeholder="Введите новый email" required value="@ViewData["NewEmail"]">
            </div>
            <button type="submit" class="btn btn-primary">Сохранить изменения</button>
        </form>
    </div>
</div>

<!-- Модальное окно для изменения пароля -->
<div id="changePasswordModal" class="modal" style="display:none;">
    <div class="modal-content">
        <span class="close" onclick="closeChangePasswordModal()">&times;</span>
        <h2>Изменить пароль</h2>
        <form action="ChangePassword" method="post" id="changePasswordForm" novalidate>
            <input type="hidden" name="userId" value="@user.UserId" />
            <div class="form-group">
                <label for="currentPasswordChange">Текущий пароль:</label>
                <input type="password" class="form-control" id="currentPasswordChange" name="currentPassword" placeholder="Введите старый пароль" required>
            </div>
            <div class="form-group">
                <label for="newPassword">Новый пароль:</label>
                <input type="password" class="form-control" id="newPassword" name="newPassword" placeholder="Введите новый пароль" required>
            </div>
            <button type="submit" class="btn btn-primary">Сохранить изменения</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openEditEmailModal() {
            document.getElementById("editEmailModal").style.display = "block";
        }
        function closeEditEmailModal() {
            document.getElementById("editEmailModal").style.display = "none";
        }
        function openChangePasswordModal() {
            document.getElementById("changePasswordModal").style.display = "block";
        }
        function closeChangePasswordModal() {
            document.getElementById("changePasswordModal").style.display = "none";
        }
        function closeResultOperation() {
            document.getElementById("resultOperation").style.display = "none";
        }

        document.addEventListener("DOMContentLoaded", function () {
            const passwordInput = document.getElementById('currentPassword');
            const emailInput = document.getElementById('newEmail');
            const passwordInputChange = document.getElementById('currentPasswordChange');

            [passwordInput, emailInput, passwordInputChange].forEach(function (input) {
                if (input) {
                    input.addEventListener('input', function () {
                        this.setCustomValidity('');
                    });
                }
            });

            var openModal = '@(ViewData["OpenModal"] ?? "")';
            if (openModal === "EditEmail") {
                openEditEmailModal();
            } else if (openModal === "ChangePassword") {
                openChangePasswordModal();
            }

            var message = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewData["Message"] ?? ""));
            if (message && message.trim().length > 0) {

                if (message.includes("Неверный пароль")) {
                    if (passwordInput) {
                        passwordInput.setCustomValidity('Неверный пароль');
                        passwordInput.reportValidity();
                    }
                }
                else if (message.includes("Неверный текущий пароль")) {
                    if (passwordInputChange) {
                        passwordInputChange.setCustomValidity('Неверный текущий пароль');
                        passwordInputChange.reportValidity();
                    }
                }
                else if (message.includes("Пользователь с таким email уже существует")) {
                    if (emailInput) {
                        emailInput.setCustomValidity('Пользователь с таким email уже существует');
                        emailInput.reportValidity();
                    }
                }
                else {
                    document.getElementById('resultOperationTitle').textContent = message;
                    document.getElementById('resultOperation').style.display = 'block';

                }
            }

        });
    </script>
}
